#include <windows.h>
#include "../shared/version.hpp"
1 RT_MANIFEST "polaris-cam.manifest"
1 VERSIONINFO
FILEVERSION TAXI_CAM_VERSION_MAJOR,TAXI_CAM_VERSION_MINOR,TAXI_CAM_VERSION_PATCH,0
PRODUCTVERSION TAXI_CAM_VERSION_MAJOR,TAXI_CAM_VERSION_MINOR,TAXI_CAM_VERSION_PATCH,0
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Polaris\0"
   VALUE "FileDescription", "Polaris Cam\0"
   VALUE "FileVersion", TAXI_CAM_VERSION "\0"
   VALUE "InternalName", "polaris-cam\0"
   VALUE "LegalCopyright", "Polaris Cam window (C) 2026 Polaris; built on Taxi Cam (C) 2026 Robert Thomson. GPL-3.0-only.\0"
   VALUE "ProductName", "Polaris Cam\0"
   VALUE "ProductVersion", TAXI_CAM_VERSION "\0"
   VALUE "OriginalFilename", "polaris-cam.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
